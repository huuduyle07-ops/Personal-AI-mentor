# Copy to .env and fill in local values. Never commit .env.
DISCORD_TOKEN=
ALLOWED_USER_ID=
# Optional development server. Global commands are also synced for DMs.
DISCORD_GUILD_ID=0
DATABASE_PATH=data/accountability.db
MIDDAY_CHECKIN=12:00
EVENING_REVIEW=21:00
# Disabled by default; only a local HTTP Ollama endpoint is accepted.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT=10
# Legacy DISCORD_BOT_TOKEN and GUILD_ID names remain supported as aliases.
